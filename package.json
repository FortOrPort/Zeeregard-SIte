{
  "scripts": {
    "build:css": "sass sass/style.scss style/style.css",
    "watch:css": "sass --watch sass/style.scss:style/style.css",
    "serve": "serve . -l 8080",
    "start": "npm run build:css && npm run serve"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "sass": "^1.100.0"
  },
  "devDependencies": {
    "serve": "^14.2.6"
  }
}
